# nxtVM — copy to .env and fill in. vCenter connections are NOT configured here:
# add them in the UI (Settings → vCenters); credentials are stored encrypted with APP_KEY.
APP_NAME=nxtVM
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Public URL of the TLS reverse proxy in front of the "web" container
APP_URL=https://nxtvm.example.com
# Time zone used to display dates (storage is always UTC)
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# PostgreSQL on the Docker host (reached from the containers via host.docker.internal)
DB_CONNECTION=pgsql
DB_HOST=host.docker.internal
DB_PORT=5432
DB_DATABASE=nxtvm
DB_USERNAME=nxtvm
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Keep true behind HTTPS; set false only for plain-HTTP testing
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# "database" works out of the box; switch both to "redis" to use Valkey / Redis
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=host.docker.internal
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="nxtvm@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# nxtVM
# Timeouts of one vCenter connection test / full collection run (seconds)
NXTVM_TEST_TIMEOUT=30
NXTVM_COLLECT_TIMEOUT=600
# Certificates expiring within these many days are shown as warning / critical
NXTVM_CERT_WARN_DAYS=60
NXTVM_CERT_CRIT_DAYS=14
# vSphere per-core licensing: minimum cores counted per physical CPU
NXTVM_LICENSE_MIN_CORES=16

# Checkup / License pages: where customers send their machine code for a license key (e-mail or text)
NXTVM_LICENSE_CONTACT=
# Audit log retention (days)
NXTVM_AUDIT_DAYS=365

VITE_APP_NAME="${APP_NAME}"
